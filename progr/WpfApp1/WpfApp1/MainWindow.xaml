<Window x:Class="LicznikWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licznik punktów"
        Height="350"
        Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">

    <Grid>
        <Border Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="25">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="LICZNIK PUNKTÓW"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="CounterBlock"
                           Text="0"
                           FontSize="60"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                <Button Content="Dodaj 1"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="16"
                        Click="Increment"/>

                <Button Content="Odejmij 1"
                        Height="40"
                        Margin="0,0,0,10"
                        FontSize="16"
                        Click="Decrement"/>

                <Button Content="Resetuj"
                        Height="35"
                        FontSize="14"
                        Click="ResetCounter"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
